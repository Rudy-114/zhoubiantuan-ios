NODE_ENV=development
PORT=18080
PUBLIC_API_BASE_URL=http://localhost:18080/api
TRUST_PROXY=false
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
EMAIL_CODE_SECRET=replace-with-a-different-long-random-string

DATABASE_URL=postgresql://zbt_dev:replace-me@127.0.0.1:5432/zbt_dev
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000

OSS_BUCKET=your-private-bucket
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=replace-me
ALIYUN_ACCESS_KEY_SECRET=replace-me

MODERATION_PROVIDER=mock
MODERATION_FAIL_MODE=review
# Development only. Production must explicitly choose a daily provider-call cap; 0 pauses automatic checks.
MODERATION_DAILY_CALL_LIMIT=1000
ALIYUN_MODERATION_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com
ALIYUN_TEXT_AGENT_APP_ID=
ALIYUN_TEXT_MODERATION_SERVICE=comment_detection
ALIYUN_IMAGE_MODERATION_SERVICE=baselineCheck

EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Existing safety system / administrator settings
DB_HOST=pgm-xxx.rwlb.rds.aliyuncs.com
DB_PORT=5432
DB_NAME=zbt_dev
DB_USER=zbt_app
DB_PASSWORD=replace-me
OSS_INTERNAL_ENDPOINT=oss-cn-shanghai-internal.aliyuncs.com
ADMIN_RECOVERY_PEPPER=
ADMIN_WEB_ENABLED=false
SAFETY_REPORT_UPLOAD_OUTSTANDING_MAX=24
SAFETY_REPORT_UPLOAD_ACCOUNT_MAX_24H=60
SAFETY_REPORT_SUPPLEMENT_ACCOUNT_MAX_24H=40
SAFETY_REPORT_SUPPLEMENT_IP_MAX_24H=120
SAFETY_REPORT_SUPPLEMENT_BURST_MAX_MINUTE=10
SAFETY_CONTENT_REVISION_ACCOUNT_MAX_24H=20
SAFETY_CONTENT_REVISION_IP_MAX_24H=60
SAFETY_CONTENT_REVISION_BURST_MAX_MINUTE=5
