{
  "name": "zhoubiantuan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:batch": "node scripts/seed-batch-posts.js",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "test:integration": "node --import ./test/setup.js --test --test-concurrency=1 test/integration/*.test.js"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.1",
    "sharp": "0.35.4",
    "ws": "^8.21.0"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    },
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": "24.x"
  }
